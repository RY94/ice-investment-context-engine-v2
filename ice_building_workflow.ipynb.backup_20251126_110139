    "print(\"✅ Entity analyzer loaded (FIXED - handles both directed and undirected graphs)\")\n",
    "print(\"\\n💡 Usage:\")\n",
    "print(\"   analyze_entity('NVDA')\")\n",
    "print(\"   analyze_entity('Tencent')\")\n",
    "print(\"   analyze_entity('semiconductor', max_relationships=30)\")\n"
