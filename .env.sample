# ICE (Investment Context Engine) Environment Variables
# Copy this file to .env and fill in your API keys and configuration

# ============================================================
# REQUIRED: Core API Keys
# ============================================================
# OpenAI API Key (Required for LLM operations)
OPENAI_API_KEY=sk-your-openai-api-key-here

# ============================================================
# OPTIONAL: Data Provider API Keys
# ============================================================
# News and Market Data APIs

# ⚠️ DEPRECATED APIs (2024 free tier changes make these unusable for live trading)
# NewsAPI.org (FREE - 1000 requests/day, 32-char key format)
# LIMITATIONS:
#   - 24-hour data delay on free tier (unsuitable for live trading/portfolio analysis)
#   - Limited small/mid-cap coverage (FICO: 0-4 articles, AAPL: 20+ articles)
#   - Query restrictions (complex queries may return 0 results, auto-fallback implemented)
# RECOMMENDED FOR:
#   ✅ Historical research (delay doesn't matter)
#   ✅ Mega-cap stocks (AAPL, NVDA, TSLA - good coverage)
# NOT RECOMMENDED FOR:
#   ❌ Live trading (use Finnhub instead - real-time, 60 req/min free)
#   ❌ Small-cap coverage (use Finnhub/MarketAux - broader database)
# IMPLEMENTATION DETAILS:
#   - Date range: Queries last 30 days (from 31 days ago to 1 day ago, accounting for 24hr delay)
#   - Context-aware routing: Excluded for 'live'/'portfolio' when real-time sources available, included for 'research'/'sentiment'
#   - Graceful degradation: If NewsAPI is ONLY source available, used even for 'portfolio' context (with 24hr delay warning)
#   - Progressive fallback: Complex query → simple fallback if 0 results
# TROUBLESHOOTING:
#   - Returns 0 articles for FICO but works for AAPL? → Expected (coverage gap, see BENZINGA_COVERAGE.md)
#   - HTTP 401 error? → Invalid/expired key, get new key at https://newsapi.org/register
#   - "Query too restrictive"? → Auto-fallback enabled (no action needed)
# SEE: project_information/about_news_apis/VERIFICATION_GUIDE.md (NewsAPI Troubleshooting section)
NEWSAPI_ORG_API_KEY=your-32-char-newsapi-key-here

# ALPHA_VANTAGE_API_KEY=your-alpha-vantage-key-here  # Reduced to 25/day (was 500/day) - unusable
# FMP_API_KEY=your-fmp-key-here  # 250 LIFETIME limit (not per day) - will exhaust quickly

# ✅ RECOMMENDED Free APIs (generous limits, actively maintained)
FINNHUB_API_KEY=your-finnhub-key-here  # 60 req/min free - BEST for news
# POLYGON_API_KEY=your-polygon-key-here  # 5 req/min free (optional, Yahoo Finance covers this)

# 💰 PAID APIs (optional, for premium features)
# BENZINGA_API_TOKEN=your-benzinga-token-here  # $99+/month for analyst ratings
# MARKETAUX_API_KEY=your-marketaux-key-here  # $29+/month for filtered news

# 🔬 Research APIs
# EXA_API_KEY=your-exa-key-here  # For on-demand competitive research

# ============================================================
# Core Configuration
# ============================================================
# Working directory for LightRAG storage (default: ./src/ice_lightrag/storage)
ICE_WORKING_DIR=./src/ice_lightrag/storage

# Batch processing settings
ICE_BATCH_SIZE=5
ICE_TIMEOUT=30
ICE_QUERY_TIMEOUT=60
ICE_MAX_CONCURRENT_QUERIES=3

# Logging configuration
ICE_LOG_LEVEL=INFO
ICE_LOG_TO_FILE=false
ICE_LOG_FILE=ice.log
ICE_DEBUG=false

# ============================================================
# Temperature Settings (LLM Behavior)
# ============================================================
# Entity Extraction Temperature (0.0-1.0, default: 0.3)
# Lower = more deterministic, Higher = more creative
ICE_LLM_TEMPERATURE_ENTITY_EXTRACTION=0.3

# Query Answering Temperature (0.0-1.0, default: 0.5)
# Lower = more factual, Higher = more diverse responses
ICE_LLM_TEMPERATURE_QUERY_ANSWERING=0.5

# ============================================================
# Feature Flags
# ============================================================
# Enhanced Entity Extraction (F1=0.74, target 0.85 not met)
# true = Use enhanced LLM extractor, false = Use baseline regex
ICE_USE_ENHANCED_EXTRACTOR=false

# Use LLM for entity extraction (requires enhanced extractor)
ICE_ENTITY_USE_LLM=false

# Signal Store (Structured data layer)
USE_SIGNAL_STORE=true
SIGNAL_STORE_PATH=data/signal_store/signal_store.db
SIGNAL_STORE_TIMEOUT=5000
SIGNAL_STORE_DEBUG=false

# Cache settings
ICE_CACHE_ENABLED=true

# Query mode (hybrid, naive, local, global)
ICE_QUERY_MODE=hybrid

# ============================================================
# Docling Configuration (Document Processing)
# ============================================================
# Enable Docling for different document types
USE_DOCLING_SEC=true      # SEC filings (10-K, 10-Q, 8-K)
USE_DOCLING_EMAIL=true    # Email attachments (PDF, DOCX)
USE_DOCLING_URLS=true     # Web page documents
USE_DOCLING_UPLOADS=false # User uploaded documents
USE_DOCLING_ARCHIVES=false # Archive files (ZIP, TAR)
USE_DOCLING_NEWS=false    # News articles

# Docling cache and logging
DOCLING_CACHE_DIR=~/.ice/docling_cache
DOCLING_LOG_CONVERSIONS=false

# ============================================================
# Crawl4AI Configuration (Web Scraping)
# ============================================================
# Enable Crawl4AI for link extraction and web content
USE_CRAWL4AI_LINKS=false

# Process URLs found in documents
ICE_PROCESS_URLS=true

# Crawl4AI settings
CRAWL4AI_TIMEOUT=60
CRAWL4AI_HEADLESS=true

# URL processing rate limiting (seconds between requests)
URL_RATE_LIMIT_DELAY=1

# ============================================================
# Manifest Mode (Deduplication & Incremental Updates)
# ============================================================
# Set to true in notebooks for smart deduplication (80-95% efficiency)
# Cell 15 in ice_building_workflow.ipynb: USE_MANIFEST = True
# Note: This is typically set in notebooks, not environment variables

# ============================================================
# SEC Company Facts API (Free XBRL Financial Metrics)
# ============================================================
# Enable/disable SEC Company Facts fetching (default: true)
# Provides authoritative XBRL metrics (Revenue, Net Income, Assets, EPS, Cash)
# 100% cost savings vs paid financial APIs, 100% accuracy (regulatory filings)
ICE_SEC_FACTS_ENABLED=true

# Number of recent quarters to fetch (default: 8 = 2 years)
# Range: 1-40 quarters (max 10 years of history)
ICE_SEC_FACTS_LOOKBACK_QUARTERS=8

# ============================================================
# Development & Testing
# ============================================================
# Enable verbose timing for performance debugging
VERBOSE_TIMING=false

# Enable test mode (uses mock data)
TEST_MODE=false

# ============================================================
# Model Provider Settings
# ============================================================
# LLM Provider (openai, anthropic, local)
LLM_PROVIDER=openai

# Embedding Provider (openai, local)
EMBEDDING_PROVIDER=openai

# Local model settings (if using local models)
LOCAL_LLM_MODEL=llama3.1:8b
LOCAL_EMBEDDING_MODEL=nomic-embed-text

# ============================================================
# Email Configuration (IMAP)
# ============================================================
# Email server settings (for email ingestion)
EMAIL_SERVER=imap.gmail.com
EMAIL_PORT=993
EMAIL_USERNAME=your-email@gmail.com
EMAIL_PASSWORD=your-app-specific-password

# ============================================================
# Production Deployment
# ============================================================
# Environment (development, staging, production)
ENVIRONMENT=development

# Feature profiles (development, production, cost-conscious)
# development: All features enabled, verbose logging
# production: Optimized settings, minimal logging
# cost-conscious: Free/cheap alternatives, no LLM calls
FEATURE_PROFILE=development

# ============================================================
# Notes
# ============================================================
# 1. REQUIRED: Only OPENAI_API_KEY is required for basic functionality
# 2. Data APIs: Add API keys for the data sources you want to use
# 3. Enhanced Extraction: Set ICE_USE_ENHANCED_EXTRACTOR=true for better accuracy (costs more)
# 4. Temperature: Lower values (0.0-0.3) for consistency, higher (0.7-1.0) for creativity
# 5. Signal Store: Provides <100ms structured queries, recommended for production
# 6. Docling: Processes complex documents (PDF, DOCX), enable based on your needs
# 7. Manifest Mode: Set USE_MANIFEST=True in notebooks for 5-20x faster re-runs

# For more details, see:
# - CLAUDE.md: Section 1.2 Essential Commands
# - ICE_ARCHITECTURE_IMPLEMENTATION_PLAN.md: Configuration details
# - config.py: Complete configuration implementation