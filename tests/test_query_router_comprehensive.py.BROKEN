"""
Comprehensive test suite for Query Router

Tests the intelligent query routing system that determines whether
queries should go to Signal Store, LightRAG, or hybrid processing.
"""

import pytest
import sys
import os
from pathlib import Path
from unittest.mock import Mock, patch, MagicMock
from datetime import datetime, timedelta
import re
