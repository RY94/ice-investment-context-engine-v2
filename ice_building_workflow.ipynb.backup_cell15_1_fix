    "### Cell 1\n",
    "\n",
    "# 🔧 Environment Setup\n",
    "import os\n",
    "import sys\n",
    "from pathlib import Path\n",
    "import warnings\n",
    "warnings.filterwarnings('ignore')\n",
    "\n",
    "# Set up paths\n",
    "project_root = Path.cwd()\n",
    "sys.path.insert(0, str(project_root))\n",
    "\n",
    "# Set API key\n",
    "os.environ['OPENAI_API_KEY'] = os.getenv('OPENAI_API_KEY', '')\n",
    "\n",
    "\n",
    "# ═══════════════════════════════════════════════════════════════════════════\n",
    "# 🎛️ API Lookback Configuration - Direct Control\n",
    "# ═══════════════════════════════════════════════════════════════════════════\n",
    "# Set exactly how many days of data to fetch from each API\n",
    "# Manifest system prevents duplicate processing - safe to experiment!\n",
    "# ═══════════════════════════════════════════════════════════════════════════\n",
    "\n",
    "# Direct numeric inputs - set any value you need\n",
    "NEWS_LOOKBACK_DAYS = 7        # Days of news to fetch (default: 7)\n",
    "FINANCIAL_LOOKBACK_DAYS = 90  # Days of financial data (default: 90)\n",
    "\n",
    "# ───────────────────────────────────────────────────────────────────────────\n",
    "# 📋 Quick Presets (uncomment to use)\n",
    "# ───────────────────────────────────────────────────────────────────────────\n",
    "\n",
    "# Cost-Conscious (60-70% API savings)\n",
    "# NEWS_LOOKBACK_DAYS = 3\n",
    "# FINANCIAL_LOOKBACK_DAYS = 30\n",
    "\n",
    "# Day Trading (ultra-recent signals)\n",
    "# NEWS_LOOKBACK_DAYS = 2\n",
    "# FINANCIAL_LOOKBACK_DAYS = 5\n",
    "\n",
    "# Swing Trading (short-term positions)\n",
    "# NEWS_LOOKBACK_DAYS = 5\n",
    "# FINANCIAL_LOOKBACK_DAYS = 20\n",
    "\n",
    "# Position Trading (medium-term)\n",
    "# NEWS_LOOKBACK_DAYS = 14\n",
    "# FINANCIAL_LOOKBACK_DAYS = 60\n",
    "\n",
    "# Long-Term Investing (comprehensive history)\n",
    "# NEWS_LOOKBACK_DAYS = 30\n",
    "# FINANCIAL_LOOKBACK_DAYS = 180\n",
    "\n",
    "# Full Historical (maximum context)\n",
    "# NEWS_LOOKBACK_DAYS = 60\n",
    "# FINANCIAL_LOOKBACK_DAYS = 365\n",
    "\n",
    "# ───────────────────────────────────────────────────────────────────────────\n",
    "# Validation and Application\n",
    "# ───────────────────────────────────────────────────────────────────────────\n",
    "\n",
    "# Validate inputs\n",
    "if not isinstance(NEWS_LOOKBACK_DAYS, int) or NEWS_LOOKBACK_DAYS < 1:\n",
    "    raise ValueError(f\"NEWS_LOOKBACK_DAYS must be positive integer, got: {NEWS_LOOKBACK_DAYS}\")\n",
    "if not isinstance(FINANCIAL_LOOKBACK_DAYS, int) or FINANCIAL_LOOKBACK_DAYS < 1:\n",
    "    raise ValueError(f\"FINANCIAL_LOOKBACK_DAYS must be positive integer, got: {FINANCIAL_LOOKBACK_DAYS}\")\n",
    "\n",
    "# Warn if values are extreme\n",
    "if NEWS_LOOKBACK_DAYS > 90:\n",
    "    print(f\"⚠️  NEWS_LOOKBACK_DAYS={NEWS_LOOKBACK_DAYS} is very high (diminishing returns after 30 days)\")\n",
    "if FINANCIAL_LOOKBACK_DAYS > 730:\n",
    "    print(f\"⚠️  FINANCIAL_LOOKBACK_DAYS={FINANCIAL_LOOKBACK_DAYS} is very high (>2 years)\")\n",
    "\n",
    "# Apply configuration\n",
    "os.environ['ICE_NEWS_LOOKBACK_DAYS'] = str(NEWS_LOOKBACK_DAYS)\n",
    "os.environ['ICE_FINANCIAL_LOOKBACK_DAYS'] = str(FINANCIAL_LOOKBACK_DAYS)\n",
    "\n",
    "# Show configuration and estimates\n",
    "print(f\"\\n📊 API Lookback Configuration:\")\n",
    "print(f\"   News APIs: {NEWS_LOOKBACK_DAYS} days\")\n",
    "print(f\"   Financial APIs: {FINANCIAL_LOOKBACK_DAYS} days\")\n",
    "\n",
    "# Estimate data volume (rough approximation)\n",
    "estimated_news = NEWS_LOOKBACK_DAYS * 5  # ~5 articles/day/ticker\n",
    "estimated_financial = FINANCIAL_LOOKBACK_DAYS  # ~1 data point/day\n",
    "print(f\"\\n📈 Estimated volume per ticker:\")\n",
    "print(f\"   ~{estimated_news} news articles\")\n",
    "print(f\"   ~{estimated_financial} financial data points\")\n",
    "\n",
    "# Cost guidance\n",
    "if NEWS_LOOKBACK_DAYS <= 3 and FINANCIAL_LOOKBACK_DAYS <= 30:\n",
    "    print(f\"\\n💰 Cost level: Low (60-70% savings vs defaults)\")\n",
    "elif NEWS_LOOKBACK_DAYS <= 7 and FINANCIAL_LOOKBACK_DAYS <= 90:\n",
    "    print(f\"\\n💰 Cost level: Balanced (recommended baseline)\")\n",
    "elif NEWS_LOOKBACK_DAYS <= 30 and FINANCIAL_LOOKBACK_DAYS <= 180:\n",
    "    print(f\"\\n💰 Cost level: Medium (comprehensive analysis)\")\n",
    "else:\n",
    "    print(f\"\\n💰 Cost level: High (extensive historical data)\")\n",
    "\n",
    "\n",
    "# Enable Docling for professional-grade document parsing (97.9% table accuracy)\n",
    "# Phase 2 implementation (2025-11-04): Docling for both email attachments AND URL PDFs\n",
    "os.environ['USE_DOCLING_EMAIL'] = 'true'   # Email attachments: 42% → 97.9%\n",
    "os.environ['USE_DOCLING_URLS'] = 'true'    # URL PDFs: 42% → 97.9% (PHASE 2 - NEW)\n",
    "os.environ['USE_DOCLING_SEC'] = 'true'     # SEC filings: metadata-only → 97.9% content extraction (PHASE 3 - NEW)\n",
    "\n",
    "# Enable Crawl4AI for complex URL processing (JS-heavy sites, portals, paywalls)\n",
    "# Set to 'true' to enable browser automation for Tier 3-5 URLs\n",
    "# Set to 'false' (default) for simple HTTP only\n",
    "os.environ['USE_CRAWL4AI_LINKS'] = 'true'  # Enable Crawl4AI\n",
    "os.environ['CRAWL4AI_TIMEOUT'] = '80'      # 60 second timeout\n",
    "os.environ['CRAWL4AI_HEADLESS'] = 'true'   # Run browser in background\n",
    "\n",
    "# URL Rate Limiting (added 2025-11-05 for robustness)\n",
    "os.environ['URL_RATE_LIMIT_DELAY'] = '1.0'      # Seconds between requests per domain (default: 1.0)\n",
    "os.environ['URL_CONCURRENT_DOWNLOADS'] = '3'     # Max concurrent downloads (default: 3)\n",
    "print(\"✅ Environment setup complete\")\n",
    "print(f\"📁 Working directory: {project_root}\")\n",
    "print(f\"📊 Docling enabled (email): {os.environ.get('USE_DOCLING_EMAIL', 'false')}\")\n",
    "print(f\"📊 Docling enabled (URLs): {os.environ.get('USE_DOCLING_URLS', 'false')}\")\n",
    "print(f\"📊 Docling enabled (SEC): {os.environ.get('USE_DOCLING_SEC', 'false')}\")\n",
    "print(f\"🌐 Crawl4AI enabled: {os.environ.get('USE_CRAWL4AI_LINKS', 'false')}\")\n",
    "\n",
