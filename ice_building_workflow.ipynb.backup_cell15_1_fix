    "        citations_text += \"\\n\\n🧠 Knowledge Graph Paths:\\n\"\n",
    "        for path in graph_paths:\n",
    "            citations_text += f\"   • {path}\\n\"\n",
    "    \n",
    "    query_result['citation_display'] = query_result.get('result', '') + citations_text\n",
    "    \n",
    "    return query_result\n",
    "\n"
