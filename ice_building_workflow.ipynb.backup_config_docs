        "\n",
        "    # Relationship type statistics\n",
        "    outgoing_types = Counter([rel for _, rel, _ in outgoing])\n",
        "    incoming_types = Counter([rel for _, rel, _ in incoming])\n",
        "\n",
        "    # Display formatted analysis\n",
        "    print(f\"\\n{'='*80}\")\n",
        "    print(f\"🔍 ENTITY ANALYSIS: {entity}\")\n",
